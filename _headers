# Cloudflare Pages response headers (onsidesoftware.com).
# Caching is left at Cloudflare's default (public, max-age=0, must-revalidate): browsers check with the server on
# every visit, so a change shows on the next reload. A Cache-Control line here would be added to that default, not replace it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The OnTime phone app's universal link (iPhone). Apple fetches this file through its own servers and needs it as JSON,
# with no redirect: it must be served from www.onsidesoftware.com, the host in the pairing link.
/.well-known/apple-app-site-association
  Content-Type: application/json

# The OnTime phone app's App Link (Android). The fingerprint today is the development (debug) key only; add the
# Play signing key's fingerprint before release.
/.well-known/assetlinks.json
  Content-Type: application/json

# The pairing page shows only when the phone app is not installed; keep it out of search and caches.
/ontime/pair/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

# OnTime's PracticePanther sign-in return page: sends the browser on to OnTime on the same computer.
# No referrer, no caching, not indexed, and only its own inline script may run.
/ontime/pp/callback/
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'none'; script-src 'sha256-tN/gYHXGmaQuqfGJOMQlUuyo7dlrukhjOKW5lcZtEk8='; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
